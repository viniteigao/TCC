{
  "name": "assinatura-eletronica-blockchain",
  "version": "0.1.0",
  "description": "Sistema de Assinatura Eletrônica via Link com Registro Imutável em Blockchain utilizando Smart Contracts (TCC)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node --env-file=.env src/server.js",
    "db:reset": "node --env-file=.env scripts/resetar-banco.js",
    "db:exportar": "node --env-file=.env scripts/exportar-banco.js",
    "db:importar": "node --env-file=.env scripts/importar-banco.js",
    "test": "node --env-file=.env --test --test-concurrency=1 testes/*.test.js",
    "metricas": "node --env-file=.env scripts/coletar-metricas.js"
  },
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "ethers": "^6.17.0",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299"
  }
}
