# Copie este arquivo para .env e preencha os valores.
# O .env fica só na sua máquina (está no .gitignore).

# Servidor
PORTA=3000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=assinatura_eletronica

# Chave AES-256 (64 caracteres hexadecimais) para cifrar os tokens dos links.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHAVE_LINKS=

# Blockchain (rede de testes Sepolia). Sem a chave e o contrato, o registro
# fica desativado e as assinaturas aguardam até a configuração ser feita.
# RPC público e gratuito da Sepolia:
BLOCKCHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Chave privada da carteira da plataforma (a conta da MetaMask usada no deploy).
# Use uma conta só de testes e nunca compartilhe esta chave.
BLOCKCHAIN_CHAVE_PRIVADA=
# Endereço do contrato RegistroDocumentos implantado pelo Remix (0x...).
BLOCKCHAIN_CONTRATO=
BLOCKCHAIN_EXPLORADOR=https://sepolia.etherscan.io
